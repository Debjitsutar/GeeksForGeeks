// ✅ Question:
// Find a Mother Vertex in a directed graph.
//
// A Mother Vertex is a vertex from which all other vertices in the graph
// can be reached through directed paths.
//
// Given V vertices and an adjacency list adj representing the graph,
// return the index of the Mother Vertex if it exists.
// Otherwise, return -1.


// ✅ Approach:
// 1. Create a visited array to track visited vertices.
// 2. Traverse all vertices from 0 to V-1.
// 3. If a vertex is not visited, perform DFS from that vertex.
//    The last vertex from which DFS starts becomes the candidate Mother Vertex.
// 4. Reset the visited array.
// 5. Perform DFS again starting from the candidate vertex.
// 6. Check if all vertices are visited:
//    - If yes → return the candidate vertex.
//    - If any vertex is not visited → return -1.


// ✅ Complexity:
//
// Time Complexity: O(V + E)
// DFS traversal takes O(V + E) and it runs at most twice.
//
// Space Complexity: O(V)
// For the visited array and recursion stack.

// ✅ Code:
class Solution {
    void dfs(int V, ArrayList<ArrayList<Integer>> adj,boolean vs[])
    {
        vs[V]=true;
        for(int nei : adj.get(V))
        {
            if(!vs[nei]) dfs(nei,adj,vs);
        }
    }
    // Function to find a Mother Vertex in the Graph.
    public int findMotherVertex(int V, ArrayList<ArrayList<Integer>> adj) {
        // Code here
        boolean vs[]=new boolean[V];
        int c=-1;
        
        for(int i=0;i<V;i++)
        {
            if(!vs[i])
            {
                dfs(i,adj,vs);
                c=i;
            }
        }
        
        vs=new boolean[V];
        dfs(c,adj,vs);
        
        for(int i=0;i<V;i++)
        {
            if(!vs[i]) return -1;
        }
        return c;
    }
}
