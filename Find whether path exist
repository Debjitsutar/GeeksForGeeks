
class Solution {
    // Function to find whether a path exists from the source to destination.
    public boolean is_Possible(int[][] grid) {
        // Code here
        int n=grid.length;
        int m=grid[0].length;
        
        int sx=-1,sy=-1;
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                if(grid[i][j]==1)
                {
                    sx=i;
                    sy=j;
                }
            }
        }
        
        Stack<int[]> st=new Stack<>();
        boolean vs[][]=new boolean[n][m];
        st.push(new int[]{sx,sy});
        
        int dx[]={1,-1,0,0};
        int dy[]={0,0,1,-1};
        
        while(!st.isEmpty())
        {
            int cur[]=st.pop();
            int x=cur[0];
            int y=cur[1];
            
            if(grid[x][y]==2) return true;
            
            vs[x][y]=true;
            for(int d=0;d<4;d++)
            {
                int nx=x+dx[d];
                int ny=y+dy[d];
                if(nx>=0 && ny>=0 && nx<n &&ny<m && grid[nx][ny]!=0 && !vs[nx][ny]) st.push(new int[]{nx,ny});
            }
        }
        return false;
    }
}
